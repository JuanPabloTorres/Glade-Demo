{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["taskId", "title", "type", "scope", "baseBranch", "workingBranch", "status", "versionStrategy", "ownedPaths", "acceptanceCriteria", "verificationCommands"],
  "properties": {
    "taskId": { "type": "string", "minLength": 8 },
    "title": { "type": "string", "minLength": 3 },
    "type": { "enum": ["feat", "fix", "refactor", "chore", "docs", "test"] },
    "scope": { "type": "string", "minLength": 1 },
    "workingBranch": { "type": "string", "pattern": "^(feat|fix|refactor|chore|docs|test|integration)/[a-z0-9][a-z0-9-]*$" },
    "status": { "enum": ["planned", "active", "blocked", "ready-for-integration", "completed"] },
    "ownedPaths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "acceptanceCriteria": { "type": "array", "minItems": 1 },
    "verificationCommands": { "type": "array", "minItems": 1 },
    "versionStrategy": { "type": "object", "required": ["mode", "bump", "owner"] }
  }
}
