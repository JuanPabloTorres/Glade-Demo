{
  "name": "matter-ready-web",
  "private": true,
  "version": "4.10.0",
  "type": "module",
  "scripts": {
    "contracts:generate": "node scripts/generate-api-contracts.mjs",
    "predev": "npm run contracts:generate",
    "dev": "vite",
    "prebuild": "npm run contracts:generate",
    "build": "tsc -b && vite build",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "i18n:check": "node scripts/validate-locales.mjs",
    "format": "prettier --write .",
    "test": "vitest",
    "preview": "vite preview",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "flowbite-react": "^0.12.9",
    "i18next": "^26.3.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^17.0.11",
    "react-icons": "^5.7.0",
    "react-router": "^7.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.1.12",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
