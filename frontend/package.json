{
  "name": "matter-ready-web",
  "private": true,
  "version": "4.15.1",
  "type": "module",
  "scripts": {
    "contracts:generate": "node scripts/generate-api-contracts.mjs",
    "predev": "npm run contracts:generate",
    "dev": "vite",
    "prebuild": "npm run contracts:generate",
    "build": "tsc -b && vite build",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "i18n:check": "node scripts/validate-locales.mjs",
    "format": "prettier --write .",
    "test": "vitest",
    "preview": "vite preview",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "flowbite-react": "^0.12.9",
    "i18next": "^26.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^17.0.12",
    "react-icons": "^5.7.0",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.1.12",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.12",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
