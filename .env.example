# Copy to .env and adjust before running the backend locally.
# See backend/app/core/config.py for the full, authoritative list of settings.

APP_NAME=FreshStart Bankruptcy Guide
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# Persistence (backend/app/core/config.py). SQLite file for the demo;
# see that field's docstring for the Postgres upgrade path
# (postgresql+psycopg://...). Previously set elsewhere (api/index.py) but
# silently dropped by Settings — now actually read.
DATABASE_URL=sqlite:///./data/freshstart.db

# Populate an *empty* database with the synthetic demo case at boot. Off here,
# and on in the Vercel function (api/index.py), whose SQLite file lives in a
# per-instance /tmp and is therefore empty after every cold start. It never
# writes over existing rows, so leaving it on once there is real data is a
# no-op rather than a wipe. See docs/DEPLOYMENT.md.
SEED_DEMO_DATA_ON_STARTUP=false

# Never reuse this default outside the demo — override before storing real data.
# Backend refuses to boot when ENVIRONMENT=production and this still equals
# the literal default baked into backend/app/core/config.py — see
# Settings._reject_default_jwt_secret_in_production.
JWT_SECRET=replace-with-a-long-random-secret-before-real-data
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=45
JWT_ISSUER=freshstart-guide
JWT_AUDIENCE=freshstart-web

# Login brute-force throttling (backend/app/core/security.py). Failed
# attempts are counted per (client IP, attempted email); exceeding the
# limit within the window returns HTTP 429 until it ages out. Defaults are
# fine for the demo — override only to tune for load testing or a stricter
# production posture.
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Demo-only accounts (SECURITY.md) — replace before any non-demo deployment.
DEMO_CLIENT_ID=client-demo
DEMO_CLIENT_EMAIL=client@freshstart.demo
DEMO_CLIENT_PASSWORD=FreshStart!2026
DEMO_CLIENT_NAME=Elena Rivera

DEMO_ATTORNEY_ID=attorney-demo
DEMO_ATTORNEY_EMAIL=attorney@freshstart.demo
DEMO_ATTORNEY_PASSWORD=Counsel!2026
DEMO_ATTORNEY_NAME=Lic. Andrea Morales

# AI provider selection — "rule_based" (default, no model/network dependency),
# "ollama" (local/Docker/VPS only — never used on the trimmed Vercel function),
# or "transformers" (requires the optional `ai` dependency group).
AI_PROVIDER=rule_based

# Which provider can actually run the agentic path, and which cannot.
#
#   rule_based   deterministic, no model, no network. The default, and what
#                every deployment runs unless this is changed.
#   openai       the agentic path. Covers any OpenAI-compatible endpoint —
#                set OPENAI_BASE_URL for Groq, Cerebras or OpenRouter (see
#                below). This is the only provider that supports the agentic
#                experience today.
#   ollama       EXPERIMENTAL, local only. Strands' Ollama adapter accepts and
#                ignores the tool-choice constraint the runtime uses to force
#                the AgentAnswer schema, so the model answers in prose, the
#                structured output is absent and every turn degrades. Measured
#                across three local models; it is a property of the adapter,
#                not of the model, so a larger model does not help.
#                `AgentRuntime` now refuses it up front and answers
#                deterministically with a diagnostic, instead of waiting on a
#                round trip it was always going to discard. Full measurement in
#                docs/audits/STRANDS-ACCEPTANCE-AUDIT.md.
#   transformers local HuggingFace inference; never routes through Strands.

# OpenAI's model id, mirroring OLLAMA_MODEL. Deliberately separate from
# AI_MODEL_ID, which is the transformers provider's HuggingFace repo id —
# handing that to OpenAI fails every call, and the runtime turns a failed call
# into a silent degrade.
OPENAI_MODEL=gpt-4o-mini

# Point the `openai` provider at any Chat Completions-compatible endpoint —
# Groq, Cerebras, OpenRouter, or Gemini's compatibility shim. This is how the
# agent runs on a free tier; OpenAI itself has none worth the name. Unset means
# OpenAI, over the Responses API, which is a different protocol. Examples in
# docs/DEPLOYMENT.md.
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL_ID=Qwen/Qwen3-0.6B
AI_MAX_NEW_TOKENS=180
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_MS=60000
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Frontend build-time variable (see frontend/src/config/environment.ts).
VITE_API_BASE_URL=http://localhost:8000
