# Copy to .env and adjust before running the backend locally.
# See backend/app/core/config.py for the full, authoritative list of settings.

APP_NAME=FreshStart Bankruptcy Guide
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# Persistence (backend/app/core/config.py). SQLite file for the demo;
# see that field's docstring for the Postgres upgrade path
# (postgresql+psycopg://...). Previously set elsewhere (api/index.py) but
# silently dropped by Settings — now actually read.
DATABASE_URL=sqlite:///./data/freshstart.db

# Never reuse this default outside the demo — override before storing real data.
JWT_SECRET=replace-with-a-long-random-secret-before-real-data
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=45
JWT_ISSUER=freshstart-guide
JWT_AUDIENCE=freshstart-web

# Demo-only accounts (SECURITY.md) — replace before any non-demo deployment.
DEMO_CLIENT_ID=client-demo
DEMO_CLIENT_EMAIL=client@freshstart.demo
DEMO_CLIENT_PASSWORD=FreshStart!2026
DEMO_CLIENT_NAME=Elena Rivera

DEMO_ATTORNEY_ID=attorney-demo
DEMO_ATTORNEY_EMAIL=attorney@freshstart.demo
DEMO_ATTORNEY_PASSWORD=Counsel!2026
DEMO_ATTORNEY_NAME=Lic. Andrea Morales

# AI provider selection — "rule_based" (default, no model/network dependency),
# "ollama" (local/Docker/VPS only — never used on the trimmed Vercel function),
# or "transformers" (requires the optional `ai` dependency group).
AI_PROVIDER=rule_based
AI_MODEL_ID=Qwen/Qwen3-0.6B
AI_MAX_NEW_TOKENS=180
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_MS=60000
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Frontend build-time variable (see frontend/src/config/environment.ts).
VITE_API_BASE_URL=http://localhost:8000
